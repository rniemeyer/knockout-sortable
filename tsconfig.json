{
	"compilerOptions": {
		"target": "ES2015",
		"module": "ESNext",
		"lib": ["ES2015", "DOM"],
		"moduleResolution": "node",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"strict": false,
		"noImplicitAny": true,
		"strictNullChecks": false,
		"strictFunctionTypes": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*", "spec/**/*", "*.config.js", "*.config.ts"],
	"exclude": ["node_modules", "build", "dist", "spec", "examples"]
}
