{
	"name": "knockout-sortable",
	"version": "2.0.0",
	"type": "module",
	"author": "Ryan Niemeyer",
	"homepage": "https://github.com/rniemeyer/knockout-sortable",
	"description": "A Knockout.js binding to connect observableArrays with jQuery UI sortable functionality",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git://github.com/rniemeyer/knockout-sortable.git"
	},
	"main": "build/knockout-sortable.js",
	"module": "build/knockout-sortable.esm.js",
	"types": "build/knockout-sortable.d.ts",
	"scripts": {
		"build": "rollup -c",
		"build:watch": "rollup -c -w",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint src spec",
		"lint:fix": "eslint src spec --fix",
		"format": "prettier --write \"**/*.{ts,js,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,js,json,md}\""
	},
	"keywords": [
		"knockout",
		"knockout.js",
		"knockoutjs",
		"sortable",
		"draggable"
	],
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^11.1.6",
		"@types/jquery": "^3.5.29",
		"@types/jqueryui": "^1.12.22",
		"@types/knockout": "^3.4.76",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"@vitest/browser": "^1.2.0",
		"@vitest/coverage-v8": "^1.2.0",
		"eslint": "^8.56.0",
		"playwright": "^1.41.0",
		"prettier": "^3.8.1",
		"rollup": "^4.9.6",
		"rollup-plugin-dts": "^6.1.0",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"vitest": "^1.2.0"
	}
}
